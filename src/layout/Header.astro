---
import { Image } from "astro:assets";
import logo from "@assets/home/logo.svg";

const NAVIGATION = [
  { label: "Inicio", href: "/#inicio" },
  { label: "Nosotros", href: "/#nosotros" },
  { label: "Contacto", href: "/#contacto" },
  { label: "Menú", href: "/#menu" },
];
---

<header class="w-full bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-5">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt="Thai Town" class="h-10 w-auto" />
    </a>
    <nav>
      <ul class="flex items-center gap-6 text-sm font-medium uppercase tracking-[0.25em] text-[#b07a4f] md:text-base">
        {NAVIGATION.map((item) => (
          <li>
            <a
              href={item.href}
              class="transition hover:text-[#8b5f3c]"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  @reference "../styles/global.css";
</style>
