---
const deliveryPlatforms = ["Uber Eats", "Rappi", "Didi Food"];
---

<footer class="bg-[#8b5f3c] text-white">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12">
    <div class="flex flex-col gap-6 text-center">
      <h2 class="text-lg font-semibold uppercase tracking-[0.3em]">Thai Town</h2>
      <p class="text-sm leading-relaxed text-white/80">
        Si quieres disfrutar de nuestros platillos, pero no puedes visitarnos,
        también puedes encontrarnos en plataformas de delivery.
      </p>
    </div>

    <div class="grid gap-4 text-center text-lg font-semibold sm:grid-cols-3">
      {deliveryPlatforms.map((platform) => (
        <div class="rounded-full border border-white/30 px-6 py-3">{platform}</div>
      ))}
    </div>

    <div id="contacto" class="text-center text-sm text-white/70">
      <p>Contacto: hola@thaitown.mx · +52 55 1234 5678</p>
    </div>
  </div>
</footer>

<style>
  @reference "../styles/global.css";
</style>
