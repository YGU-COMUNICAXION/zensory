---
import { ClientRouter } from "astro:transitions";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Thai Town | Comunidad tailandesa en México</title>
    <meta
      name="description"
      content="Thai Town es un espacio de comunidad tailandesa en México con platillos icónicos, calidez y tradición."
    />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-neutral-900">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
